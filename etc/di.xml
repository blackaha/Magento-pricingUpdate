<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Blackaha\PricingUpdater\Model\NonceRegistryInterface" type="Blackaha\PricingUpdater\Model\Ledger"/>

    <!-- var/log/pricing_updater.log. Never receives a secret. -->
    <virtualType name="Blackaha\PricingUpdater\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/pricing_updater.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="Blackaha\PricingUpdater\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">pricing_updater</argument>
            <argument name="handlers" xsi:type="array">
                <item name="file" xsi:type="object">Blackaha\PricingUpdater\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Blackaha\PricingUpdater\Model\Connector">
        <arguments>
            <argument name="logger" xsi:type="object">Blackaha\PricingUpdater\Logger</argument>
        </arguments>
    </type>
    <type name="Blackaha\PricingUpdater\Model\Writer">
        <arguments>
            <argument name="logger" xsi:type="object">Blackaha\PricingUpdater\Logger</argument>
        </arguments>
    </type>
    <type name="Blackaha\PricingUpdater\Controller\Webhook\Index">
        <arguments>
            <argument name="logger" xsi:type="object">Blackaha\PricingUpdater\Logger</argument>
        </arguments>
    </type>
    <type name="Blackaha\PricingUpdater\Controller\Connect\Callback">
        <arguments>
            <argument name="logger" xsi:type="object">Blackaha\PricingUpdater\Logger</argument>
        </arguments>
    </type>
</config>
