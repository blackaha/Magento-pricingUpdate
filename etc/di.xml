<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="BlackAha\DynamicPricing\Model\NonceRegistryInterface" type="BlackAha\DynamicPricing\Model\Ledger"/>

    <!-- var/log/dynamic_pricing.log. Never receives a secret. -->
    <virtualType name="BlackAha\DynamicPricing\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/dynamic_pricing.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="BlackAha\DynamicPricing\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">dynamic_pricing</argument>
            <argument name="handlers" xsi:type="array">
                <item name="file" xsi:type="object">BlackAha\DynamicPricing\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="BlackAha\DynamicPricing\Model\Connector">
        <arguments>
            <argument name="logger" xsi:type="object">BlackAha\DynamicPricing\Logger</argument>
        </arguments>
    </type>
    <type name="BlackAha\DynamicPricing\Model\Writer">
        <arguments>
            <argument name="logger" xsi:type="object">BlackAha\DynamicPricing\Logger</argument>
        </arguments>
    </type>
    <type name="BlackAha\DynamicPricing\Controller\Webhook\Index">
        <arguments>
            <argument name="logger" xsi:type="object">BlackAha\DynamicPricing\Logger</argument>
        </arguments>
    </type>
    <type name="BlackAha\DynamicPricing\Controller\Connect\Callback">
        <arguments>
            <argument name="logger" xsi:type="object">BlackAha\DynamicPricing\Logger</argument>
        </arguments>
    </type>
</config>
